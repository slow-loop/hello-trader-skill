# TW Trader Backend Configuration

# --- Core API Keys ---
# Required for any LLM-based research (ResearchEngine)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Required for TwStock chips data (Institutional Investors)
# Get a token at: https://finmind.github.io/
FINMIND_API_KEY=your_finmind_token_here

# Required for real-time TWSE market data (Quotes & Ticker info)
# Get a token at: https://developer.fugle.tw/
FUGLE_API_KEY=your_fugle_api_key_here


# --- Database Configuration ---
# Options: sqlite, supabase (default is sqlite)
DB_BACKEND=sqlite

# Required if DB_BACKEND=supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key


# --- Messaging Services (Optional) ---
# Used for Line Bot integration
LINE_CHANNEL_SECRET=your_line_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_token

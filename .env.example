# Copy to .env and fill in your real keys. .env is gitignored.
# Loaded by tw-trader at startup; web-reader and market-core read from
# the resulting os.environ.

# === Taiwan market data (used by market-core[tw] / tw-trader) ===
# Fugle: https://developer.fugle.tw/
FUGLE_API_KEY=

# FinMind: https://finmind.github.io/
FINMIND_API_KEY=

# === web-reader ===
# Yahoo Mail app password (IMAP)
# https://login.yahoo.com/account/security → Generate app password
YAHOO_MAIL_USERNAME=
YAHOO_MAIL_PASSWORD=

# YouTube Data API v3 (channel/video metadata)
# https://console.cloud.google.com → enable YouTube Data API v3
YOUTUBE_API_KEY=

# Groq (audio transcription for YouTube / Apple Podcast)
# https://console.groq.com/keys
GROQ_API_KEY=

# Jina Reader (optional, improves web extraction)
# https://jina.ai/reader
JINA_API_KEY=

# Optional: yt-dlp cookies file for age-restricted content
# YOUTUBE_COOKIES=/path/to/cookies.txt

# Optional: web-reader SQLite cache path
# WEB_READER_DB_PATH=/custom/path/store.db

# === Misc ===
LOG_LEVEL=INFO

# Fugle Market Data API (Required for reliable Taiwan stock quotes & volume)
# Get it from: https://developer.fugle.tw/
FUGLE_API_KEY=your_fugle_api_key_here

# FinMind API (Required for Taiwan stock chips/institutional flow & revenue)
# Get it from: https://finmind.github.io/
FINMIND_API_KEY=your_finmind_api_key_here

# Finnhub API (Required for US stock quotes & global market data)
# Get it from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here


# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

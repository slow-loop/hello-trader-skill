# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# --- Yahoo Mail (IMAP) ---
# App Password: https://login.yahoo.com/account/security → Generate app password
YAHOO_MAIL_USERNAME=your_address@yahoo.com
YAHOO_MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# --- YouTube ---
# Data API key: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Groq (audio transcription for YouTube / Apple Podcast)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: path to YouTube cookies file for age-restricted content (yt-dlp)
# YOUTUBE_COOKIES=/path/to/cookies.txt

# --- Web Reader ---
# Jina Reader API key (optional, improves web page extraction)
# https://jina.ai/reader
JINA_API_KEY=your_jina_api_key_here

# Custom SQLite cache DB path (optional, default: .web-reader/store.db)
# WEB_READER_DB_PATH=/custom/path/store.db
